generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  priceNGN    Float
  color       String
  sizesStock  Json     // Holds: { "M": 0, "L": 9, "XL": 0, "2XL": 0 }
  images      String[]
  published   Boolean  @default(false)
  position    Int      @default(0) 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  reference   String      @unique
  email       String
  firstName   String
  lastName    String
  phone       String
  address     String
  city        String
  state       String
  items       Json
  subtotalNGN Float
  deliveryFee Float       @default(2500)
  totalNGN    Float
  currency    String      @default("NGN")
  status      OrderStatus @default(PAID)
  paystackRef String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  DELIVERED
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}